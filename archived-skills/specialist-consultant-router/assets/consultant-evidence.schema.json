{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "顾问证据记录",
  "description": "逐行记录顾问问题中来源与主张的支持、反驳、适用范围和证据强度；结构通过不代表结论真实或已获专业认证。",
  "type": "object",
  "required": [
    "项目ID",
    "证据集ID",
    "证据集版本",
    "证据行ID",
    "问题包ID与版本",
    "主张ID",
    "支持关系",
    "来源层级",
    "来源类型",
    "来源标题",
    "作者或机构",
    "发布日期或年代",
    "定位信息",
    "可访问引用",
    "获取日期",
    "适用范围",
    "直接性",
    "权威性",
    "独立性",
    "证据强度",
    "支持内容摘要",
    "限制与冲突",
    "核验状态"
  ],
  "properties": {
    "项目ID": {"type": "string", "minLength": 1},
    "证据集ID": {"type": "string", "pattern": "^CED-[A-Z0-9-]+$"},
    "证据集版本": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "证据行ID": {"type": "string", "pattern": "^EVD-[0-9]{3,}$"},
    "问题包ID与版本": {"type": "string", "pattern": "^CQP-[A-Z0-9-]+@v[0-9]{3,}$"},
    "主张ID": {"type": "string", "pattern": "^CLM-[0-9]{3,}$"},
    "支持关系": {"type": "string", "enum": ["支持", "反驳", "限定", "仅提供背景"]},
    "来源层级": {"type": "string", "enum": ["权威规则或原始档案", "一手专业资料", "同行评审或专业组织", "用户提供可定位资料", "可信二手专业解释", "未核验线索"]},
    "来源类型": {"type": "string", "minLength": 1},
    "来源标题": {"type": "string", "minLength": 1},
    "作者或机构": {"type": "string", "minLength": 1},
    "发布日期或年代": {"type": "string", "minLength": 1},
    "定位信息": {"type": "string", "minLength": 1},
    "可访问引用": {"type": "string", "minLength": 1},
    "获取日期": {"type": "string", "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}|不适用)$"},
    "适用范围": {"type": "string", "minLength": 1},
    "直接性": {"type": "string", "enum": ["直接", "间接", "背景"]},
    "权威性": {"type": "string", "enum": ["高", "中", "低", "未核验"]},
    "独立性": {"type": "string", "enum": ["独立来源", "同源转述", "无法判断", "不适用"]},
    "证据强度": {"type": "string", "enum": ["强", "中", "弱", "不可用"]},
    "支持内容摘要": {"type": "string", "minLength": 1},
    "限制与冲突": {"type": "string", "minLength": 1},
    "核验状态": {"type": "string", "enum": ["已定位并核验", "待交叉核验", "存在冲突", "不可用"]}
  },
  "additionalProperties": false
}
