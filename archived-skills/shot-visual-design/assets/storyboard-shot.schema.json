{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "正式分镜镜头",
  "type": "object",
  "required": [
    "项目ID",
    "分镜组ID",
    "分镜组版本",
    "镜头ID",
    "镜头版本",
    "镜头序号",
    "生成单元ID",
    "生成单元成员镜头ID集合",
    "被替代生成单元ID集合",
    "对应剧本事实ID",
    "时长秒",
    "本镜叙事任务",
    "为什么需要本镜",
    "观众视点",
    "场景空间依据ID与版本",
    "景别对象",
    "景别",
    "生命体形态与运动约束集版本",
    "VFX正式资产定义时序与接触版本",
    "VFX本镜阶段与执行条款",
    "第一帧状态",
    "稳定结束状态",
    "下一镜头ID与版本或场末",
    "剪辑关系ID",
    "切点时机",
    "切点理由",
    "动作接点",
    "声音接点",
    "相邻状态结论",
    "剪辑节奏数据集与卡精确引用",
    "为什么选择本机位与运镜"
  ],
  "properties": {
    "项目ID": {"type": "string", "minLength": 1},
    "分镜组ID": {"type": "string", "minLength": 1},
    "分镜组版本": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "镜头ID": {"type": "string", "minLength": 1},
    "镜头版本": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "镜头序号": {"type": "integer", "minimum": 1},
    "生成单元ID": {"type": "string", "minLength": 1},
    "生成单元成员镜头ID集合": {"type": "string", "minLength": 1},
    "被替代生成单元ID集合": {"type": "string", "minLength": 1},
    "对应剧本事实ID": {"type": "string", "minLength": 1},
    "时长秒": {"type": "number", "exclusiveMinimum": 0},
    "本镜叙事任务": {"type": "string", "minLength": 1},
    "为什么需要本镜": {"type": "string", "minLength": 1},
    "观众视点": {"type": "string", "minLength": 1},
    "场景空间依据ID与版本": {"type": "string", "pattern": "^[^@；]+@v[0-9]{3,}$"},
    "景别对象": {"type": "string", "minLength": 1},
    "景别": {"type": "string", "minLength": 1},
    "摄影机高度与角度": {"type": "string"},
    "侧别与遮挡": {"type": "string"},
    "距离视场与透视": {"type": "string"},
    "构图重心与负空间": {"type": "string"},
    "运镜": {"type": "string"},
    "运镜触发与停止": {"type": "string"},
    "人物调度与表演": {"type": "string"},
    "原台词": {"type": "string"},
    "调用正式资产": {"type": "string"},
    "生命体形态与运动约束集版本": {"type": "string", "minLength": 1},
    "VFX正式资产定义时序与接触版本": {"type": "string", "minLength": 1},
    "VFX本镜阶段与执行条款": {"type": "string", "minLength": 1},
    "声音": {"type": "string"},
    "第一帧状态": {"type": "string", "minLength": 1},
    "稳定结束状态": {"type": "string", "minLength": 1},
    "下一镜头ID与版本或场末": {"type": "string", "pattern": "^(场末|[^@；]+@v[0-9]{3,})$"},
    "剪辑关系ID": {"type": "string", "pattern": "^(待剪辑建立|CUT-[0-9]{3,})$"},
    "切点时机": {"type": "string", "minLength": 1},
    "切点理由": {"type": "string", "minLength": 1},
    "动作接点": {"type": "string", "minLength": 1},
    "声音接点": {"type": "string", "minLength": 1},
    "相邻状态结论": {"type": "string", "minLength": 1},
    "剪辑节奏数据集与卡精确引用": {"type": "string", "pattern": "^(待剪辑检查|ERT-[A-Z0-9-]+@v[0-9]{3,}；ERC-[A-Z0-9-]+@v[0-9]{3,})$"},
    "为什么选择本机位与运镜": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}

