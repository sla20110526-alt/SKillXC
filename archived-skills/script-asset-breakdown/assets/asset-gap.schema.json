{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "资产信息缺口",
  "type": "object",
  "required": ["项目ID", "缺口ID", "资产类型", "缺失信息", "为何需要", "责任Skill", "返回节点", "当前状态"],
  "properties": {
    "项目ID": {"type": "string", "minLength": 1},
    "缺口ID": {"type": "string", "minLength": 1},
    "预留正式资产ID": {"type": ["string", "null"]},
    "资产类型": {"type": "string", "minLength": 1},
    "缺失信息": {"type": "string", "minLength": 1},
    "为何需要": {"type": "string", "minLength": 1},
    "责任Skill": {"type": "string", "minLength": 1},
    "返回节点": {"type": "string", "minLength": 1},
    "当前状态": {"type": "string", "enum": ["待确认", "待补充", "已解决", "暂缓"]}
  },
  "additionalProperties": false
}
