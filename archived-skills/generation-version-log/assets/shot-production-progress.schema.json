{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "镜头生产进度",
  "type": "object",
  "required": [
    "项目ID",
    "分镜组ID",
    "分镜组版本",
    "镜头ID与版本集合",
    "生成单元ID",
    "正式PromptID",
    "Prompt版本",
    "Prompt状态",
    "Prompt当前有效",
    "Prompt状态依据类型",
    "Prompt状态依据原文",
    "生成结果状态",
    "结果当前采用",
    "结果状态依据类型",
    "结果状态依据原文",
    "来源任务或对话",
    "记录日期"
  ],
  "properties": {
    "项目ID": {"type": "string", "minLength": 1},
    "分镜组ID": {"type": "string", "minLength": 1},
    "分镜组版本": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "镜头ID与版本集合": {"type": "string", "minLength": 1},
    "生成单元ID": {"type": "string", "minLength": 1},
    "正式PromptID": {"type": "string", "minLength": 1},
    "Prompt版本": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "上一Prompt版本": {"type": ["string", "null"]},
    "Prompt状态": {"type": "string", "enum": ["待人工检查", "已放行生成", "需修订", "已替代"]},
    "Prompt当前有效": {"type": "string", "enum": ["是", "否"]},
    "Prompt状态依据类型": {"type": "string", "enum": ["系统交付", "用户明确确认", "用户明确返修", "版本替代", "项目汇总"]},
    "Prompt状态依据原文": {"type": "string", "minLength": 1},
    "生成结果状态": {"type": "string", "enum": ["未生成或未回报", "生成中", "需返修", "部分可用", "可用", "已替代"]},
    "结果当前采用": {"type": "string", "enum": ["未决定", "是", "否"]},
    "结果状态依据类型": {"type": "string", "enum": ["系统初始化", "用户明确确认", "用户明确返修", "用户明确弃用", "项目汇总"]},
    "结果状态依据原文": {"type": "string", "minLength": 1},
    "可用结果定位": {"type": "string"},
    "来源任务或对话": {"type": "string", "minLength": 1},
    "记录日期": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
