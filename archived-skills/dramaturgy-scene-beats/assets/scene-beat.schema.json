{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "场戏逐节拍数据",
  "description": "记录锁定剧本场次中每个戏剧节拍的出处、目标、障碍、策略、可见行为、潜台词以及信息、权力与状态变化；不记录机位、焦段或运镜。",
  "type": "object",
  "required": [
    "项目ID",
    "场戏节拍集ID",
    "节拍集版本",
    "场次ID",
    "节拍ID",
    "节拍序号",
    "剧本内容版本",
    "原文定位",
    "剧本事实ID集合",
    "原文锁定项",
    "触发",
    "行动人物ID",
    "人物目标",
    "障碍",
    "策略",
    "可见行为",
    "潜台词",
    "信息进入状态",
    "信息变化",
    "信息离开状态",
    "权力进入状态",
    "权力变化",
    "权力离开状态",
    "节拍进入状态",
    "节拍离开状态",
    "事件顺序锚点",
    "因果依据",
    "字段依据与标签",
    "锁定项保护结论",
    "歧义或缺口"
  ],
  "properties": {
    "项目ID": {"type": "string", "minLength": 1},
    "场戏节拍集ID": {"type": "string", "pattern": "^BDT-[A-Z0-9-]+$"},
    "节拍集版本": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "场次ID": {"type": "string", "pattern": "^SCN-[A-Z0-9-]+$"},
    "节拍ID": {"type": "string", "pattern": "^BT-[0-9]{3,}$"},
    "节拍序号": {"type": "integer", "minimum": 1},
    "剧本内容版本": {"type": "string", "minLength": 1},
    "原文定位": {"type": "string", "minLength": 1},
    "剧本事实ID集合": {"type": "string", "minLength": 1},
    "原文锁定项": {"type": "string", "minLength": 1},
    "触发": {"type": "string", "minLength": 1},
    "行动人物ID": {"type": "string", "minLength": 1},
    "人物目标": {"type": "string", "minLength": 1},
    "障碍": {"type": "string", "minLength": 1},
    "策略": {"type": "string", "minLength": 1},
    "可见行为": {"type": "string", "minLength": 1},
    "潜台词": {"type": "string", "minLength": 1},
    "信息进入状态": {"type": "string", "minLength": 1},
    "信息变化": {"type": "string", "minLength": 1},
    "信息离开状态": {"type": "string", "minLength": 1},
    "权力进入状态": {"type": "string", "minLength": 1},
    "权力变化": {"type": "string", "minLength": 1},
    "权力离开状态": {"type": "string", "minLength": 1},
    "节拍进入状态": {"type": "string", "minLength": 1},
    "节拍离开状态": {"type": "string", "minLength": 1},
    "事件顺序锚点": {"type": "string", "minLength": 1},
    "因果依据": {"type": "string", "minLength": 1},
    "字段依据与标签": {"type": "string", "minLength": 1, "description": "逐项映射触发、目标、策略、可见行为、潜台词、信息变化和权力变化的事实ID或分析依据，以及SCRIPT_EXPLICIT、SCRIPT_INFERRED、USER_LOCKED、CREATIVE_PROPOSAL或UNKNOWN标签。"},
    "锁定项保护结论": {"type": "string", "enum": ["保持原文", "不适用"]},
    "歧义或缺口": {"type": "string"}
  },
  "additionalProperties": false
}
