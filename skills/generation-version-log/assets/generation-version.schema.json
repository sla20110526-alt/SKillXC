{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "生成版本记录",
  "type": "object",
  "required": ["项目ID", "生成批次ID", "目标需求槽位或镜头", "Prompt类型", "PromptID", "模型", "Prompt版本", "Prompt路径或正文", "结论对象", "用户结论", "记录日期"],
  "properties": {
    "项目ID": {"type": "string", "minLength": 1},
    "生成批次ID": {"type": "string", "minLength": 1},
    "目标需求槽位或镜头": {"type": "string", "minLength": 1},
    "分镜组ID": {"type": "string"},
    "分镜组版本": {"type": "string"},
    "镜头ID与版本集合": {"type": "string"},
    "生成单元ID": {"type": "string"},
    "Prompt类型": {"type": "string", "enum": ["图片Prompt", "正式视频Prompt", "声音生成Prompt", "其他Prompt"]},
    "PromptID": {"type": "string", "minLength": 1},
    "模型": {"type": "string", "minLength": 1},
    "平台设置": {"type": "string"},
    "Prompt版本": {"type": "string", "minLength": 1},
    "Prompt路径或正文": {"type": "string", "minLength": 1},
    "参考输入": {"type": "string"},
    "结果文件": {"type": "string"},
    "结论对象": {"type": "string", "enum": ["Prompt", "生成结果", "生成批次", "详细版本"]},
    "用户结论": {"type": "string", "enum": ["Prompt待人工检查", "Prompt已放行生成", "Prompt需修订", "生成结果需返修", "生成结果部分可用", "生成结果可用", "失败", "待调整", "仅记录版本"]},
    "用户失败描述": {"type": "string"},
    "AI诊断": {"type": "string"},
    "修订方向": {"type": "string"},
    "上一版本": {"type": ["string", "null"]},
    "记录日期": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
