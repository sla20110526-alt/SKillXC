{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "生成单元就绪审计",
  "type": "object",
  "required": ["项目ID", "生成单元ID", "分镜组ID", "分镜组版本", "镜头ID与版本集合", "调用正式资产", "表演母档与场戏卡版本", "首帧状态", "结束状态", "场戏声音卡ID与版本", "声音来源结论", "声音身份卡与版本", "正式声音资产版本平台引用名与调用方式", "临时声音用户确认原文", "对白环境声与禁用项", "参考负载结论", "版本冲突", "缺口", "生成就绪结论", "复核日期"],
  "properties": {
    "项目ID": {"type": "string", "minLength": 1},
    "生成单元ID": {"type": "string", "minLength": 1},
    "分镜组ID": {"type": "string", "minLength": 1},
    "分镜组版本": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "镜头ID与版本集合": {"type": "string", "minLength": 1},
    "调用正式资产": {"type": "string", "minLength": 1},
    "平台引用名": {"type": "string"},
    "表演母档与场戏卡版本": {"type": "string", "minLength": 1},
    "首帧状态": {"type": "string", "minLength": 1},
    "结束状态": {"type": "string", "minLength": 1},
    "动作视线银幕方向": {"type": "string"},
    "场戏声音卡ID与版本": {"type": "string", "minLength": 1},
    "声音来源结论": {"type": "string", "enum": ["正式声音资产", "用户已确认临时声音", "本单元无需独立声音资产", "未决定"]},
    "声音身份卡与版本": {"type": "string", "minLength": 1},
    "正式声音资产版本平台引用名与调用方式": {"type": "string", "minLength": 1},
    "临时声音用户确认原文": {"type": "string", "minLength": 1},
    "对白环境声与禁用项": {"type": "string", "minLength": 1},
    "参考负载结论": {"type": "string", "enum": ["通过", "需减载", "待确认"]},
    "版本冲突": {"type": "string"},
    "缺口": {"type": "string"},
    "生成就绪结论": {"type": "string", "enum": ["可继续", "有条件继续", "暂停"]},
    "复核日期": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
