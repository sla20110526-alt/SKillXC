{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "影视专业 Profile Markdown 卡元数据",
  "type": "object",
  "required": [
    "ProfileID",
    "卡片版本",
    "当前状态",
    "资料成熟度",
    "专业部门",
    "主体名称",
    "主体类型",
    "代表作品",
    "适用阶段",
    "Profile默认作用域",
    "Profile本体失效点",
    "可跨阶段继承",
    "方法证据状态",
    "来源ID"
  ],
  "properties": {
    "ProfileID": {
      "type": "string",
      "pattern": "^FP-(DIR|CIN|PD|WRI|EDI)-[A-Z0-9-]+$"
    },
    "卡片版本": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+$"
    },
    "当前状态": {
      "type": "string",
      "enum": ["待补资料", "受限可选", "可选择", "暂停使用", "已替代"]
    },
    "资料成熟度": {
      "type": "string",
      "enum": ["提纲", "初版", "已核验", "项目验证"]
    },
    "专业部门": {
      "type": "string",
      "enum": ["导演", "摄影指导", "美术／Production Design", "编剧／剧作", "剪辑"]
    },
    "主体名称": {
      "type": "string",
      "minLength": 1
    },
    "主体类型": {
      "type": "string",
      "enum": ["个人", "组合"]
    },
    "代表作品": {
      "type": "string",
      "minLength": 1
    },
    "适用阶段": {
      "type": "string",
      "minLength": 1
    },
    "Profile默认作用域": {
      "type": "string",
      "minLength": 1
    },
    "Profile本体失效点": {
      "type": "string",
      "minLength": 1
    },
    "可跨阶段继承": {
      "type": "string",
      "minLength": 1
    },
    "方法证据状态": {
      "type": "string",
      "enum": ["用户提供", "分析性归纳", "直接观察", "来源支持", "混合证据"]
    },
    "来源ID": {
      "type": "string",
      "pattern": "^SRC-[A-Z0-9-]+(?:、SRC-[A-Z0-9-]+)*$"
    }
  },
  "additionalProperties": false,
  "x-profile-contract": {
    "contract_version": "v1.1",
    "required_sections": [
      "Profile 记录",
      "核心工作问题",
      "可观察方法与证据",
      "决策顺序",
      "适用与误用风险",
      "部门交接",
      "当前项目短执行卡",
      "来源与升级缺口"
    ],
    "method_evidence_enum": ["用户提供", "直接观察", "来源支持", "分析性归纳"],
    "minimum_methods": 3,
    "allowed_stage_by_department": {
      "导演": "项目风格意图基线；导演与人物调度",
      "摄影指导": "全片摄影基线；用户明确确认的限时场戏摄影例外",
      "美术／Production Design": "美术与 LookDev",
      "编剧／剧作": "剧作与场戏节拍",
      "剪辑": "剪辑与节奏"
    },
    "expiry_by_department": {
      "导演": "本次项目风格意图基线或导演调度卡交付后；另一阶段不得自动续用",
      "摄影指导": "全片摄影规则卡交付后；限时场戏例外在所写场次或镜头范围结束后",
      "美术／Production Design": "美术/LookDev 规则卡交付后",
      "编剧／剧作": "场戏节拍卡交付后",
      "剪辑": "剪辑节奏卡交付后"
    },
    "inheritance_by_department": {
      "导演": "仅项目风格意图卡或导演调度卡中的可执行项目规则切片；不得继承Profile本体、姓名、片名或未采用方法",
      "摄影指导": "仅全片摄影规则卡或用户确认的限时场戏例外卡中的可执行项目规则切片；不得继承Profile本体、姓名、片名或未采用方法",
      "美术／Production Design": "仅美术/LookDev规则卡中的可执行项目规则切片；不得继承Profile本体、姓名、片名或未采用方法",
      "编剧／剧作": "仅场戏节拍卡中的剧本事实、节拍、信息与权力变化切片；不得继承Profile本体、姓名、片名或未采用方法",
      "剪辑": "仅剪辑节奏卡中的镜头关系、时长、切点、动作/声音接点与生成单元切片；不得继承Profile本体、姓名、片名或未采用方法"
    },
    "maturity_status_rules": {
      "提纲": ["待补资料", "暂停使用", "已替代"],
      "初版": ["受限可选", "暂停使用", "已替代"],
      "已核验": ["可选择", "暂停使用", "已替代"],
      "项目验证": ["可选择", "暂停使用", "已替代"]
    }
  }
}
