{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "角色表演母档",
  "type": "object",
  "required": [
    "项目ID",
    "表演母档ID",
    "角色ID",
    "角色名称",
    "母档版本",
    "上一母档版本",
    "母档状态",
    "当前有效",
    "适用范围",
    "项目锁定卡版本",
    "剧本内容版本",
    "依据场次范围",
    "源定义引用",
    "表演尺度与参考",
    "稳定表演核心",
    "贯穿目标与行动引擎",
    "默认社会面具",
    "关系对象差异",
    "私下基线",
    "角色弧线阶段与不可提前泄露",
    "地位行为与失控反差",
    "压力反应阶梯",
    "面具破裂条件",
    "倾听与反应模式",
    "眼神与注意力模式",
    "呼吸与张力模式",
    "重心姿态与步态",
    "习惯动作业务与触发条件",
    "距离与接触边界",
    "动作惯性与恢复",
    "场戏可变项",
    "禁止表演方式",
    "事实与创作来源",
    "母档卡路径",
    "内容指纹SHA256",
    "状态依据类型",
    "状态依据原文",
    "生效依据原文",
    "记录日期",
    "生效日期"
  ],
  "properties": {
    "项目ID": {"type": "string", "minLength": 1},
    "表演母档ID": {"type": "string", "minLength": 1},
    "角色ID": {"type": "string", "minLength": 1},
    "角色名称": {"type": "string", "minLength": 1},
    "母档版本": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "上一母档版本": {"type": "string", "minLength": 1},
    "母档状态": {"type": "string", "enum": ["待确认", "已生效", "已替代", "已失效"]},
    "当前有效": {"type": "string", "enum": ["是", "否"]},
    "适用范围": {"type": "string", "minLength": 1},
    "项目锁定卡版本": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "剧本内容版本": {"type": "string", "minLength": 1},
    "依据场次范围": {"type": "string", "minLength": 1},
    "源定义引用": {"type": "string", "pattern": "^CCS-ACTING-MASTER@v[0-9]{3,}$"},
    "关联人物正式资产ID与版本": {"type": "string"},
    "关联生物怪物正式资产ID与版本": {"type": "string"},
    "表演尺度与参考": {"type": "string", "minLength": 1},
    "稳定表演核心": {"type": "string", "minLength": 1},
    "贯穿目标与行动引擎": {"type": "string", "minLength": 1},
    "默认社会面具": {"type": "string", "minLength": 1},
    "关系对象差异": {"type": "string", "minLength": 1},
    "私下基线": {"type": "string", "minLength": 1},
    "角色弧线阶段与不可提前泄露": {"type": "string", "minLength": 1},
    "地位行为与失控反差": {"type": "string", "minLength": 1},
    "压力反应阶梯": {"type": "string", "minLength": 1},
    "面具破裂条件": {"type": "string", "minLength": 1},
    "倾听与反应模式": {"type": "string", "minLength": 1},
    "眼神与注意力模式": {"type": "string", "minLength": 1},
    "呼吸与张力模式": {"type": "string", "minLength": 1},
    "重心姿态与步态": {"type": "string", "minLength": 1},
    "习惯动作业务与触发条件": {"type": "string", "minLength": 1},
    "距离与接触边界": {"type": "string", "minLength": 1},
    "动作惯性与恢复": {"type": "string", "minLength": 1},
    "场戏可变项": {"type": "string", "minLength": 1},
    "禁止表演方式": {"type": "string", "minLength": 1},
    "事实与创作来源": {"type": "string", "minLength": 1},
    "未知与待确认": {"type": "string"},
    "母档卡路径": {"type": "string", "minLength": 1},
    "内容指纹SHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "状态依据类型": {"type": "string", "enum": ["系统草案", "用户明确确认", "版本替代", "用户明确停用"]},
    "状态依据原文": {"type": "string", "minLength": 1},
    "生效依据原文": {"type": "string", "minLength": 1},
    "记录日期": {"type": "string", "minLength": 1},
    "生效日期": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
