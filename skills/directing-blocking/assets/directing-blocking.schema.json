{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "场戏调度单元",
  "type": "object",
  "required": [
    "项目ID", "场戏调度数据集ID", "调度数据集版本", "场次ID", "调度单元ID", "调度序号", "节拍ID", "行动人物ID",
    "DSB与BDT精确引用", "空间圣经ID与版本", "空间锚点ID集合", "表演母档ID与版本", "观众跟随对象", "观众知情关系",
    "必须看见信息", "暂不可见信息", "人物起始坐标或分区", "人物结束坐标或分区", "与对象起始距离", "与对象结束距离",
    "起始朝向", "结束朝向", "起始视线目标", "结束视线目标", "遮挡与揭示", "进入或离开", "移动触发", "空间行动与路径",
    "行动目的", "接触对象与结果", "权力进入状态", "权力空间变化", "权力离开状态", "轴线ID", "银幕方向", "越轴与重建空间",
    "画外行动与声音线索", "连续性结束状态", "生命体运动约束引用", "VFX时序与接触引用", "顾问结论精确引用",
    "专项场景视图缺口", "字段依据与状态"
  ],
  "properties": {
    "项目ID": {"type": "string", "minLength": 1},
    "场戏调度数据集ID": {"type": "string", "pattern": "^DBD-[A-Z0-9-]+$"},
    "调度数据集版本": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "场次ID": {"type": "string", "pattern": "^SCN-[A-Z0-9-]+$"},
    "调度单元ID": {"type": "string", "pattern": "^BLK-[0-9]{3,}$"},
    "调度序号": {"type": "integer", "minimum": 1},
    "节拍ID": {"type": "string", "pattern": "^BT-[0-9]{3,}$"},
    "行动人物ID": {"type": "string", "minLength": 1},
    "DSB与BDT精确引用": {"type": "string", "pattern": "^DSB-[A-Z0-9-]+@v[0-9]{3,}；BDT-[A-Z0-9-]+@v[0-9]{3,}$"},
    "空间圣经ID与版本": {"type": "string", "pattern": "^[^@；]+@v[0-9]{3,}$"},
    "空间锚点ID集合": {"type": "string", "minLength": 1},
    "表演母档ID与版本": {"type": "string", "minLength": 1},
    "观众跟随对象": {"type": "string", "minLength": 1},
    "观众知情关系": {"type": "string", "minLength": 1},
    "必须看见信息": {"type": "string", "minLength": 1},
    "暂不可见信息": {"type": "string", "minLength": 1},
    "人物起始坐标或分区": {"type": "string", "minLength": 1},
    "人物结束坐标或分区": {"type": "string", "minLength": 1},
    "与对象起始距离": {"type": "string", "minLength": 1},
    "与对象结束距离": {"type": "string", "minLength": 1},
    "起始朝向": {"type": "string", "minLength": 1},
    "结束朝向": {"type": "string", "minLength": 1},
    "起始视线目标": {"type": "string", "minLength": 1},
    "结束视线目标": {"type": "string", "minLength": 1},
    "遮挡与揭示": {"type": "string", "minLength": 1},
    "进入或离开": {"type": "string", "enum": ["无", "进入", "离开", "进入后离开", "始终画外"]},
    "移动触发": {"type": "string", "minLength": 1},
    "空间行动与路径": {"type": "string", "minLength": 1},
    "行动目的": {"type": "string", "minLength": 1},
    "接触对象与结果": {"type": "string", "minLength": 1},
    "权力进入状态": {"type": "string", "minLength": 1},
    "权力空间变化": {"type": "string", "minLength": 1},
    "权力离开状态": {"type": "string", "minLength": 1},
    "轴线ID": {"type": "string", "pattern": "^AX-[A-Z0-9-]+$"},
    "银幕方向": {"type": "string", "minLength": 1},
    "越轴与重建空间": {"type": "string", "minLength": 1},
    "画外行动与声音线索": {"type": "string", "minLength": 1},
    "连续性结束状态": {"type": "string", "minLength": 1},
    "生命体运动约束引用": {"type": "string", "minLength": 1},
    "VFX时序与接触引用": {"type": "string", "minLength": 1},
    "顾问结论精确引用": {"type": "string", "minLength": 1},
    "专项场景视图缺口": {"type": "string", "minLength": 1},
    "字段依据与状态": {"type": "string", "minLength": 1},
    "备注": {"type": "string"}
  },
  "additionalProperties": false
}
