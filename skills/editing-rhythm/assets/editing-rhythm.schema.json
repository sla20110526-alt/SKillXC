{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "剪辑节奏关系单元",
  "type": "object",
  "required": [
    "项目ID", "剪辑节奏数据集ID", "节奏数据集版本", "分镜组ID", "输入分镜组版本", "剪辑关系ID", "剪辑序号",
    "当前镜头ID与版本", "下一镜头ID与版本或场末", "当前时长秒", "建议时长秒", "时长依据", "镜头新增价值",
    "切点时机", "切点理由类型", "切点理由", "动作接点", "声音接点", "当前镜头第一帧状态", "当前镜头稳定结束状态",
    "下一镜头第一帧状态或场末", "相邻状态结论", "当前生成单元ID", "建议生成单元ID", "建议生成单元成员镜头ID集合",
    "生成单元决定", "被替代生成单元ID集合", "生成单元进入状态", "生成单元稳定结束状态", "修订动作", "返回责任Skill",
    "调度表演摄影来源引用", "字段依据与状态"
  ],
  "properties": {
    "项目ID": {"type": "string", "minLength": 1},
    "剪辑节奏数据集ID": {"type": "string", "pattern": "^ERT-[A-Z0-9-]+$"},
    "节奏数据集版本": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "分镜组ID": {"type": "string", "minLength": 1},
    "输入分镜组版本": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "剪辑关系ID": {"type": "string", "pattern": "^CUT-[0-9]{3,}$"},
    "剪辑序号": {"type": "integer", "minimum": 1},
    "当前镜头ID与版本": {"type": "string", "pattern": "^[^@；]+@v[0-9]{3,}$"},
    "下一镜头ID与版本或场末": {"type": "string", "pattern": "^(场末|[^@；]+@v[0-9]{3,})$"},
    "当前时长秒": {"type": "number", "exclusiveMinimum": 0},
    "建议时长秒": {"type": "number", "exclusiveMinimum": 0},
    "时长依据": {"type": "string", "minLength": 1},
    "镜头新增价值": {"type": "string", "minLength": 1},
    "切点时机": {"type": "string", "minLength": 1},
    "切点理由类型": {"type": "string", "enum": ["情绪", "信息", "动作", "声音", "组合", "场末"]},
    "切点理由": {"type": "string", "minLength": 1},
    "动作接点": {"type": "string", "minLength": 1},
    "声音接点": {"type": "string", "minLength": 1},
    "当前镜头第一帧状态": {"type": "string", "minLength": 1},
    "当前镜头稳定结束状态": {"type": "string", "minLength": 1},
    "下一镜头第一帧状态或场末": {"type": "string", "minLength": 1},
    "相邻状态结论": {"type": "string", "minLength": 1},
    "当前生成单元ID": {"type": "string", "minLength": 1},
    "建议生成单元ID": {"type": "string", "minLength": 1},
    "建议生成单元成员镜头ID集合": {"type": "string", "minLength": 1},
    "生成单元决定": {"type": "string", "enum": ["保持", "拆分", "合并", "成员变化", "新建"]},
    "被替代生成单元ID集合": {"type": "string", "minLength": 1},
    "生成单元进入状态": {"type": "string", "minLength": 1},
    "生成单元稳定结束状态": {"type": "string", "minLength": 1},
    "修订动作": {"type": "string", "minLength": 1},
    "返回责任Skill": {"type": "string", "enum": ["无需返工", "shot-visual-design", "cinematography-direction", "directing-blocking", "acting-direction", "dramaturgy-scene-beats"]},
    "调度表演摄影来源引用": {"type": "string", "minLength": 1},
    "字段依据与状态": {"type": "string", "minLength": 1},
    "备注": {"type": "string"}
  },
  "additionalProperties": false
}
