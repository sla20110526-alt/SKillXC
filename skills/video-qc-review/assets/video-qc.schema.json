{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "视频QC正式记录",
  "type": "object",
  "required": [
    "项目ID", "QC记录集ID", "记录集版本", "QC工作模式", "问题ID", "分镜组ID与版本", "镜头ID与版本", "生成单元ID",
    "正式PromptID与版本", "参考映射ID与版本", "生成结果定位", "证据类型", "证据定位", "时间点或画面范围", "可观察问题",
    "期望依据ID与版本或用户要求", "严重度", "问题类别", "根因层", "根因判定状态", "根因证据", "唯一归属Skill或节点",
    "建议返回节点", "最小修订方向", "复核动作", "用户结果结论", "用户结论原文", "用户记录授权原文", "记录日期"
  ],
  "properties": {
    "项目ID": {"type": "string", "minLength": 1},
    "QC记录集ID": {"type": "string", "pattern": "^QCR-[A-Z0-9-]+$"},
    "记录集版本": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "QC工作模式": {"type": "string", "enum": ["正式记录", "项目复盘记录"]},
    "问题ID": {"type": "string", "pattern": "^ISS-[0-9]{3,}$"},
    "分镜组ID与版本": {"type": "string", "pattern": "^[^@；]+@v[0-9]{3,}$"},
    "镜头ID与版本": {"type": "string", "pattern": "^[^@；]+@v[0-9]{3,}$"},
    "生成单元ID": {"type": "string", "minLength": 1},
    "正式PromptID与版本": {"type": "string", "pattern": "^VPR-[A-Z0-9-]+@v[0-9]{3,}$"},
    "参考映射ID与版本": {"type": "string", "pattern": "^VRM-[A-Z0-9-]+@v[0-9]{3,}$"},
    "生成结果定位": {"type": "string", "minLength": 1},
    "证据类型": {"type": "string", "enum": ["有声视频", "无声视频", "截图", "用户明确文字反馈", "组合证据"]},
    "证据定位": {"type": "string", "minLength": 1},
    "时间点或画面范围": {"type": "string", "minLength": 1},
    "可观察问题": {"type": "string", "minLength": 8},
    "期望依据ID与版本或用户要求": {"type": "string", "minLength": 1},
    "严重度": {"type": "string", "enum": ["阻断", "重要", "可接受偏差"]},
    "问题类别": {"type": "string", "enum": ["人物身份与状态", "表演与口型", "动作与物理接触", "构图与运镜", "空间与光线", "连续性", "VFX", "声音"]},
    "根因层": {"type": "string", "enum": ["上游设计错误", "Prompt漏译或冲突", "参考映射或负载问题", "模型随机偏差", "证据不足暂不可判定"]},
    "根因判定状态": {"type": "string", "enum": ["已确认", "高概率", "待复核"]},
    "根因证据": {"type": "string", "minLength": 8},
    "唯一归属Skill或节点": {"type": "string", "minLength": 1},
    "建议返回节点": {"type": "string", "minLength": 1},
    "最小修订方向": {"type": "string", "minLength": 8},
    "复核动作": {"type": "string", "minLength": 8},
    "用户结果结论": {"type": "string", "enum": ["未提供", "需返修", "部分可用", "可用", "放弃"]},
    "用户结论原文": {"type": "string", "minLength": 1},
    "用户记录授权原文": {"type": "string", "minLength": 1},
    "记录日期": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "备注": {"type": "string"}
  },
  "additionalProperties": false
}
