{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "生命体运动约束",
  "type": "object",
  "required": ["项目ID", "形态定义ID", "形态定义版本", "预留正式资产ID", "正式资产ID与版本", "运动约束集ID", "运动约束集版本", "运动模式ID", "运动模式", "起始静止姿态", "支撑与接触点", "质量分布", "发力部位", "第一动作", "关节活动范围", "步态或运动节律", "速度级别", "转向与制动", "惯性", "环境接触", "次级运动", "身份锚点可见要求", "禁止动作", "物理规则来源", "验证状态"],
  "properties": {
    "项目ID": {"type": "string", "minLength": 1},
    "形态定义ID": {"type": "string", "minLength": 1},
    "形态定义版本": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "预留正式资产ID": {"type": "string", "minLength": 1},
    "正式资产ID与版本": {"type": "string", "pattern": "^(未登记|[^@；]+@v[0-9]{3,})$"},
    "运动约束集ID": {"type": "string", "minLength": 1},
    "运动约束集版本": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "运动模式ID": {"type": "string", "minLength": 1},
    "运动模式": {"type": "string", "enum": ["站立", "行走", "奔跑", "跳跃", "爬行", "攀附", "飞行", "滑翔", "游动", "钻行", "形态切换", "其他"]},
    "起始静止姿态": {"type": "string", "minLength": 1},
    "支撑与接触点": {"type": "string", "minLength": 1},
    "质量分布": {"type": "string", "minLength": 1},
    "发力部位": {"type": "string", "minLength": 1},
    "第一动作": {"type": "string", "minLength": 1},
    "关节活动范围": {"type": "string", "minLength": 1},
    "步态或运动节律": {"type": "string", "minLength": 1},
    "速度级别": {"type": "string", "minLength": 1},
    "转向与制动": {"type": "string", "minLength": 1},
    "惯性": {"type": "string", "minLength": 1},
    "环境接触": {"type": "string", "minLength": 1},
    "次级运动": {"type": "string", "minLength": 1},
    "身份锚点可见要求": {"type": "string", "minLength": 1},
    "禁止动作": {"type": "string", "minLength": 1},
    "物理规则来源": {"type": "string", "enum": ["现实生物力学", "顾问结论", "用户锁定超自然规则", "创作建议待确认", "资料不足"]},
    "验证状态": {"type": "string", "enum": ["待确认", "已确认", "顾问已核对", "资料不足"]},
    "备注": {"type": "string"}
  },
  "additionalProperties": false
}
