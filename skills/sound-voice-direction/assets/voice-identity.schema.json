{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "角色声音身份",
  "type": "object",
  "required": [
    "项目ID",
    "声音身份卡ID",
    "说话者ID",
    "说话者名称",
    "身份卡版本",
    "上一身份卡版本",
    "身份卡状态",
    "当前有效",
    "适用范围",
    "项目锁定卡版本",
    "剧本内容版本",
    "依据场次与台词范围",
    "源定义引用",
    "语言",
    "方言口音边界",
    "年龄感",
    "基础音高范围",
    "音色质地",
    "共鸣与气息",
    "基础语速与节奏",
    "咬字与句尾",
    "动态范围",
    "压力下允许变化",
    "禁止变化与禁用特征",
    "口型同步要求",
    "参考来源与授权状态",
    "事实与创作来源",
    "身份卡路径",
    "内容指纹SHA256",
    "状态依据类型",
    "状态依据原文",
    "生效依据原文",
    "记录日期",
    "生效日期"
  ],
  "properties": {
    "项目ID": {"type": "string", "minLength": 1},
    "声音身份卡ID": {"type": "string", "minLength": 1},
    "说话者ID": {"type": "string", "minLength": 1},
    "说话者名称": {"type": "string", "minLength": 1},
    "身份卡版本": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "上一身份卡版本": {"type": "string", "minLength": 1},
    "身份卡状态": {"type": "string", "enum": ["待确认", "已生效", "已替代", "已失效"]},
    "当前有效": {"type": "string", "enum": ["是", "否"]},
    "适用范围": {"type": "string", "minLength": 1},
    "项目锁定卡版本": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "剧本内容版本": {"type": "string", "minLength": 1},
    "依据场次与台词范围": {"type": "string", "minLength": 1},
    "源定义引用": {"type": "string", "pattern": "^CCS-VOICE-IDENTITY@v[0-9]{3,}$"},
    "关联人物正式资产ID与版本": {"type": "string"},
    "预留正式声音资产ID": {"type": "string"},
    "语言": {"type": "string", "minLength": 1},
    "方言口音边界": {"type": "string", "minLength": 1},
    "年龄感": {"type": "string", "minLength": 1},
    "基础音高范围": {"type": "string", "minLength": 1},
    "音色质地": {"type": "string", "minLength": 1},
    "共鸣与气息": {"type": "string", "minLength": 1},
    "基础语速与节奏": {"type": "string", "minLength": 1},
    "咬字与句尾": {"type": "string", "minLength": 1},
    "动态范围": {"type": "string", "minLength": 1},
    "压力下允许变化": {"type": "string", "minLength": 1},
    "禁止变化与禁用特征": {"type": "string", "minLength": 1},
    "口型同步要求": {"type": "string", "minLength": 1},
    "参考来源与授权状态": {"type": "string", "minLength": 1},
    "事实与创作来源": {"type": "string", "minLength": 1},
    "未知与待确认": {"type": "string"},
    "身份卡路径": {"type": "string", "minLength": 1},
    "内容指纹SHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "状态依据类型": {"type": "string", "enum": ["系统草案", "用户明确确认", "版本替代", "用户明确停用"]},
    "状态依据原文": {"type": "string", "minLength": 1},
    "生效依据原文": {"type": "string", "minLength": 1},
    "记录日期": {"type": "string", "minLength": 1},
    "生效日期": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
