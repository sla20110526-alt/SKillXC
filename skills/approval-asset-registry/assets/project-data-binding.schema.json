{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "项目数据绑定索引",
  "type": "object",
  "required": ["项目ID", "项目名称", "绑定卡版本", "绑定状态", "项目数据根目录", "项目锁定卡相对路径", "项目锁定索引相对路径", "项目数据绑定索引相对路径", "正式资产登记表相对路径", "可调用资产表相对路径", "资产状态传播表相对路径", "资产文件根目录相对路径", "检查报告目录相对路径", "数据契约版本", "绑定卡路径"],
  "properties": {
    "项目ID": {"type": "string", "minLength": 1},
    "项目名称": {"type": "string", "minLength": 1},
    "绑定卡版本": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "绑定状态": {"type": "string", "enum": ["待确认", "已绑定", "已失效"]},
    "项目数据根目录": {"type": "string", "minLength": 1},
    "项目锁定卡相对路径": {"type": "string", "minLength": 1},
    "项目锁定索引相对路径": {"type": "string", "minLength": 1},
    "项目数据绑定索引相对路径": {"type": "string", "minLength": 1},
    "正式资产登记表相对路径": {"type": "string", "minLength": 1},
    "可调用资产表相对路径": {"type": "string", "minLength": 1},
    "资产状态传播表相对路径": {"type": "string", "minLength": 1},
    "资产文件根目录相对路径": {"type": "string", "minLength": 1},
    "检查报告目录相对路径": {"type": "string", "minLength": 1},
    "数据契约版本": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+$"},
    "绑定卡路径": {"type": "string", "minLength": 1},
    "确认人": {"type": "string"},
    "确认日期": {"type": "string"}
  },
  "additionalProperties": false
}
