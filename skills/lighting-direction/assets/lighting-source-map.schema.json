{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "场景光源地图",
  "description": "按光影状态记录有来源的光、反射/回弹与负补光控制项；结构通过不代表灯光创作质量或资产批准。",
  "type": "object",
  "required": ["项目ID", "成果ID", "成果版本", "场景ID", "光影状态ID", "空间圣经ID与版本", "空间依据资产ID与版本", "光源或控光ID", "光角色", "来源类型", "空间锚点ID", "世界位置或方向", "朝向与作用区域", "形状与相对尺寸", "色温或颜色", "相对强度与优先级", "范围与衰减", "遮挡束光与控光", "开关或时序状态", "主阴影贡献", "反射与色彩污染", "定义依据", "锁定级别", "允许变化", "禁止变化", "备注"],
  "properties": {
    "项目ID": {"type": "string", "minLength": 1},
    "成果ID": {"type": "string", "pattern": "^LMP-[A-Z0-9-]+$"},
    "成果版本": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "场景ID": {"type": "string", "minLength": 1},
    "光影状态ID": {"type": "string", "minLength": 1},
    "空间圣经ID与版本": {"type": "string", "pattern": "^[^@；]+@v[0-9]{3,}$"},
    "空间依据资产ID与版本": {"type": "string", "pattern": "^[^@；]+@v[0-9]{3,}$"},
    "光源或控光ID": {"type": "string", "minLength": 1},
    "光角色": {"type": "string", "enum": ["主方向光", "实景光", "环境填充", "反射或回弹", "负补光", "VFX自发光"]},
    "来源类型": {"type": "string", "enum": ["太阳", "天空", "窗户传入光", "人工灯具", "火焰", "霓虹", "车灯", "反射面", "环境场", "VFX自发光", "黑旗或暗面", "其他"]},
    "空间锚点ID": {"type": "string", "minLength": 1},
    "世界位置或方向": {"type": "string", "minLength": 1},
    "朝向与作用区域": {"type": "string", "minLength": 1},
    "形状与相对尺寸": {"type": "string", "minLength": 1},
    "色温或颜色": {"type": "string", "minLength": 1},
    "相对强度与优先级": {"type": "string", "minLength": 1},
    "范围与衰减": {"type": "string", "minLength": 1},
    "遮挡束光与控光": {"type": "string", "minLength": 1},
    "开关或时序状态": {"type": "string", "minLength": 1},
    "主阴影贡献": {"type": "string", "minLength": 1},
    "反射与色彩污染": {"type": "string", "minLength": 1},
    "定义依据": {"type": "string", "minLength": 1},
    "锁定级别": {"type": "string", "enum": ["已生效基线继承", "空间锚点锁定", "用户确认", "剧本明确", "VFX定义继承", "推断待确认"]},
    "允许变化": {"type": "string", "minLength": 1},
    "禁止变化": {"type": "string", "minLength": 1},
    "备注": {"type": "string"}
  },
  "additionalProperties": false
}
