{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "场景视图锚点投影",
  "type": "object",
  "required": ["项目ID", "空间圣经ID", "空间圣经版本", "视图预留正式资产ID", "视图正式资产ID与版本", "视图用途", "空间依据资产ID与版本", "摄影机位置", "摄影机朝向", "摄影机高度", "视场与透视", "锚点ID", "画面水平位置", "景深层级", "可见状态", "投影依据", "一致性结论"],
  "properties": {
    "项目ID": {"type": "string", "minLength": 1},
    "空间圣经ID": {"type": "string", "minLength": 1},
    "空间圣经版本": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "视图预留正式资产ID": {"type": "string", "minLength": 1},
    "视图正式资产ID与版本": {"type": "string", "pattern": "^(未登记|[^@；]+@v[0-9]{3,})$"},
    "视图用途": {"type": "string", "enum": ["预制剧情视图", "专项镜头视图", "英雄剧照视图", "场景状态视图", "光影状态视图"]},
    "空间依据资产ID与版本": {"type": "string", "pattern": "^[^@；]+@v[0-9]{3,}$"},
    "摄影机位置": {"type": "string", "minLength": 1},
    "摄影机朝向": {"type": "string", "minLength": 1},
    "摄影机高度": {"type": "string", "minLength": 1},
    "视场与透视": {"type": "string", "minLength": 1},
    "锚点ID": {"type": "string", "minLength": 1},
    "画面水平位置": {"type": "string", "enum": ["画外左", "左", "中", "右", "画外右", "横跨", "待确认"]},
    "景深层级": {"type": "string", "enum": ["前景", "中景", "后景", "横跨", "画外", "待确认"]},
    "可见状态": {"type": "string", "enum": ["完整可见", "部分可见", "被遮挡", "画外", "未知区", "待确认"]},
    "可见表面": {"type": "string"},
    "遮挡者锚点ID": {"type": "string"},
    "投影依据": {"type": "string", "enum": ["母图可见", "空间几何关系", "已登记补充视图", "用户锁定", "推断待确认"]},
    "一致性结论": {"type": "string", "enum": ["通过", "待确认", "冲突", "不适用"]},
    "备注": {"type": "string"}
  },
  "additionalProperties": false
}
