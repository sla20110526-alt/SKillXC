{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "候选资产拆解条目",
  "type": "object",
  "required": ["项目ID", "预留正式资产ID", "资产类型", "暂定资产名称", "基础或变体", "剧本出处", "信息来源", "当前状态"],
  "properties": {
    "项目ID": {"type": "string", "minLength": 1},
    "预留正式资产ID": {"type": "string", "minLength": 1},
    "资产类型": {"type": "string", "enum": ["人物", "服装妆造", "场景", "场景视图", "光影", "道具", "载具", "生物怪物", "VFX", "图案文字", "声音"]},
    "暂定资产名称": {"type": "string", "minLength": 1},
    "基础或变体": {"type": "string", "enum": ["基础", "变体", "组合", "待确认"]},
    "父预留正式资产ID": {"type": ["string", "null"]},
    "附加预留正式资产ID集合": {"type": ["string", "null"]},
    "剧本出处": {"type": "string", "minLength": 1},
    "关联场次": {"type": "string"},
    "信息来源": {"type": "string", "enum": ["剧本明确", "用户锁定", "创作建议", "待确认"]},
    "连续性要求": {"type": "string"},
    "声音类别": {"type": "string", "enum": ["", "角色声音参考音频", "待确认"]},
    "当前状态": {"type": "string", "enum": ["候选", "待确认", "已进入需求计划", "暂缓"]}
  },
  "additionalProperties": false
}
