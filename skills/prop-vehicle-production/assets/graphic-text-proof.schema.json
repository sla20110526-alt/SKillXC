{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "图案文字逐项校对",
  "type": "object",
  "required": ["项目ID", "文字定义ID", "文字定义版本", "预留正式资产ID", "正式资产ID与版本", "内容类型", "语言", "书写方向", "逐字内容", "大小写与全半角", "行序与换行", "字体类别", "版式与对齐", "图形结构与方向", "目标资产ID与版本", "应用区域锚点ID", "应用工艺", "事实来源", "内容依据原文", "校对状态"],
  "properties": {
    "项目ID": {"type": "string", "minLength": 1},
    "文字定义ID": {"type": "string", "minLength": 1},
    "文字定义版本": {"type": "string", "pattern": "^v[0-9]{3,}$"},
    "预留正式资产ID": {"type": "string", "minLength": 1},
    "正式资产ID与版本": {"type": "string", "pattern": "^(未登记|[^@；]+@v[0-9]{3,})$"},
    "内容类型": {"type": "string", "enum": ["纯文字", "纯图形", "图文组合", "编号标记"]},
    "语言": {"type": "string", "minLength": 1},
    "书写方向": {"type": "string", "enum": ["从左到右", "从右到左", "从上到下", "混合", "不适用"]},
    "逐字内容": {"type": "string", "minLength": 1},
    "大小写与全半角": {"type": "string", "minLength": 1},
    "行序与换行": {"type": "string", "minLength": 1},
    "字体类别": {"type": "string", "minLength": 1},
    "版式与对齐": {"type": "string", "minLength": 1},
    "图形结构与方向": {"type": "string", "minLength": 1},
    "目标资产ID与版本": {"type": "string", "pattern": "^(不适用|[^@；]+@v[0-9]{3,})$"},
    "应用区域锚点ID": {"type": "string", "minLength": 1},
    "应用工艺": {"type": "string", "minLength": 1},
    "颜色": {"type": "string"},
    "磨损规则": {"type": "string"},
    "事实来源": {"type": "string", "enum": ["剧本明确", "用户锁定", "顾问结论", "创作建议待确认"]},
    "内容依据原文": {"type": "string", "minLength": 1},
    "校对状态": {"type": "string", "enum": ["待核对", "逐字通过", "图形通过", "发现错误", "不适用"]},
    "备注": {"type": "string"}
  },
  "additionalProperties": false
}
